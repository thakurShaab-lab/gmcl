NODE_ENV=Development
PORT=3001

# DB Configuration (same database the PHP API used)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_POOL_SIZE=10

# Optional
# APP_TIMEZONE=Asia/Kolkata            # PHP date() timezone (production PHP used Asia/Kolkata)
# APP_BASE_URL=https://example.com/    # base_url() used in image paths; default: http(s)://<Host header>/
# UPLOAD_DIR=/path/to/uploaded_files   # PHP UPLOAD_DIR (document root /uploaded_files)
# PHP_DOCROOT=/home/gmcljain/public_html/  # path printed in reproduced PHP error messages
# MAIL_HOST= MAIL_PORT=587 MAIL_SECURE=false MAIL_USER= MAIL_PASS=   # SMTP; default: local sendmail like PHP mail()
