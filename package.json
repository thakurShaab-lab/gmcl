{
  "name": "gmcl-node-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit introspect",
    "db:studio": "drizzle-kit studio",
    "test:api": "newman run postman/GMCL_API.postman_collection.json -e postman/GMCL_API.local.postman_environment.json"
  },
  "description": "GMCL mobile API (Express + Drizzle ORM), migrated from the CodeIgniter PHP API",
  "dependencies": {
    "busboy": "^1.6.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "entities": "^8.1.0",
    "express": "^4.22.3",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.15",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "newman": "^6.2.2",
    "nodemon": "^3.1.14"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
